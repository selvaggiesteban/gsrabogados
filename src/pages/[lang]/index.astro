  /* ===== 2. EL ESTUDIO - SLIDER ===== */
  .estudio__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  .estudio__slider {
    position: relative;
  }

  .estudio__slides {
    position: relative;
    min-height: 250px;
  }

  .estudio__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 800ms ease-in-out;
    pointer-events: none;
  }


  .estudio__slide--active {
    opacity: 1;
    position: relative;
    pointer-events: auto;
  }

  .estudio__slide-text {
    font-family: var(--font-secondary);
    font-weight: var(--weight-light);
    font-size: 24px;
    line-height: 1.3em;
    color: var(--color-cream);
    text-align: center;
  }


  @media (max-width: 1024px) {
    .estudio__slide-text {
      font-size: 16px;
    }
  }

  .estudio__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .estudio__dot {
    width: 6px;
    height: 6px;
    border-radius: 0;
    background: rgba(246, 230, 212, 0.3);
    border: none;
    cursor: pointer;
    padding: 0;
    transform: rotate(45deg);
    transition: background var(--transition-fast), transform var(--transition-fast);
  }

  .estudio__dot--active {
    background: var(--color-cream);
    transform: rotate(45deg) scale(1.2);
  }

  .estudio__image {
    overflow: hidden;
  }

  .estudio__img {
    width: 100%;
    max-height: 300px;
    height: 300px;
    object-fit: cover;
    object-position: center center;
    display: block;
  }

  @media (max-width: 1024px) {
    .estudio__img {
      height: 300px;
      max-height: 300px;
    }
  }

  @media (max-width: 768px) {
    .estudio__grid {
      grid-template-columns: 1fr;
    }
    .estudio__image {
      order: -1;
    }
  }

  /* ===== 3. AREAS - ACCORDION ===== */
  .section__header--center {
    text-align: center;
  }

  .accordion {
    max-width: 900px;
    margin: 0 auto;
  }

  @media (max-width: 768px) {
