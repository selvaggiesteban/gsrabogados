  .accordion__item {
    --accordion-offset: calc(32px + var(--space-6));
    border-bottom: 2px solid #1D1412;
  }

  .accordion__header {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    padding: var(--space-6) 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
  }

  .accordion__number {
    font-family: var(--font-primary);
    font-weight: 200;
    font-size: var(--text-lg);
    color: var(--color-dark-brown);
    letter-spacing: 0.05em;
    min-width: 32px;
  }

  .accordion__title {
    flex: 1;
    font-family: var(--font-secondary);
    font-weight: 400;
    font-size: 38px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-dark-brown);
  }

  .accordion__icon {
    width: 32px;
    height: 32px;
    position: relative;
    flex-shrink: 0;
    border: 1px solid #1D1412;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .accordion__icon::before {
    content: '';
    width: 8px;
    height: 8px;
    border-right: 1.5px solid #1D1412;
    border-bottom: 1.5px solid #1D1412;
    transform: translateY(-2px) rotate(45deg);
    transition: transform var(--transition-base);
  }

  .accordion__item--open .accordion__icon::before {
    transform: translateY(2px) rotate(-135deg);
  }

  .accordion__panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-base);
  }

  .accordion__item--open .accordion__panel {
    max-height: 600px;
  }

  .accordion__text {
    font-family: var(--font-secondary);
    font-weight: var(--weight-light);
    font-size: 16px;
    color: var(--color-dark-brown);
    text-align: justify;
    hyphens: auto;
    padding: var(--space-4) 0 var(--space-6) var(--accordion-offset);
    margin: 0;
  }

  @media (max-width: 768px) {
    .accordion__title {
      font-size: 26px;
    }
    .accordion__number {
      font-size: 15px;
      min-width: 28px;
    }
