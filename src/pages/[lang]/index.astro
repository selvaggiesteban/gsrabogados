<script>
  // Slider del Estudio
  (function() {
    const dots = document.querySelectorAll('.estudio__dot');
    const slides = document.querySelectorAll('.estudio__slide');
    if (!dots.length || !slides.length) return;

    function showSlide(index) {
      slides.forEach((slide, i) => {
        slide.classList.toggle('estudio__slide--active', i === index);
      });
      dots.forEach((dot, i) => {
        dot.classList.toggle('estudio__dot--active', i === index);
        dot.setAttribute('aria-selected', i === index);
      });
    }

    let currentIndex = 0;
    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const target = parseInt(dot.dataset.target);
        currentIndex = target;
        showSlide(target);
      });
    });

    // Touch support for sliding
    let touchStartX = 0;
    let touchEndX = 0;

    const sliderContainer = document.getElementById('estudio-slider');
    if (sliderContainer) {
      sliderContainer.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      sliderContainer.addEventListener('touchend', (e) => {
        touchEndX = e.changedTouches[0].screenX;
        handleGesture();
      }, { passive: true });
    }

    function handleGesture() {
      const swipeThreshold = 50;
      if (touchEndX < touchStartX - swipeThreshold) {
        // Swipe left -> next slide
        currentIndex = (currentIndex + 1) % slides.length;
        showSlide(currentIndex);
      } else if (touchEndX > touchStartX + swipeThreshold) {
        // Swipe right -> previous slide
        currentIndex = (currentIndex - 1 + slides.length) % slides.length;
        showSlide(currentIndex);
      }
    }

    // Auto-advance cada 6 segundos
    setInterval(() => {
      currentIndex = (currentIndex + 1) % slides.length;
      showSlide(currentIndex);
    }, 6000);
  })();

  // Accordion Areas
  (function() {
    const headers = document.querySelectorAll('.accordion__header');
    headers.forEach((header) => {
      header.addEventListener('click', () => {
        const item = header.parentElement;
        const isOpen = item.classList.contains('accordion__item--open');
        header.setAttribute('aria-expanded', !isOpen);
        item.classList.toggle('accordion__item--open');
      });
    });
  })();

  // Contact Form Logic
  (function() {
    const form = document.getElementById('contact-form');
    const btn = document.getElementById('submit-btn');
    const responseDiv = document.getElementById('form-response');
    if (!form || !btn || !responseDiv) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Honeypot check
      const botField = document.getElementById('bot_field').value;
      if (botField) return;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      // UI State: Loading
      btn.classList.add('contacto__btn--loading');
      btn.textContent = 'ENVIANDO...';
      responseDiv.style.display = 'none';

      try {
        const response = await fetch('/bridge.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (result.success) {
          responseDiv.textContent = result.message || 'Mensaje enviado con éxito. Nos contactaremos a la brevedad.';
          responseDiv.className = 'contacto__response contacto__response--success';
          form.reset();
        } else {
          throw new Error(result.message || 'Hubo un error al enviar el mensaje.');
        }
      } catch (error) {
        responseDiv.textContent = error.message || 'Error de conexión. Por favor, intente más tarde.';
        responseDiv.className = 'contacto__response contacto__response--error';
      } finally {
        btn.classList.remove('contacto__btn--loading');
        btn.textContent = 'ENVIAR';
        responseDiv.style.display = 'block';
      }
    });
  })();

</script>
