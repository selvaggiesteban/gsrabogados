---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, defaultLang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

export async function getStaticPaths() {
  const langs = Object.keys(languages);
  return langs.map(lang => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = await useTranslations(lang);

const title = t.get('home.title');
const description = t.get('home.description');
---

<BaseLayout title={title} description={description} lang={lang}>
  <!-- ===== 1. HERO ===== -->
  <section class="hero" aria-labelledby="hero-title">
    <img src="/images/asset-hero.webp" alt="" class="hero__bg" loading="eager" fetchpriority="high" width="1920" height="1080" />
    <div class="hero__content section__inner">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__title-line hero__title-line-1">{t.get('hero.line1')}</span>
        <span class="hero__title-line hero__title-line-2">{t.get('hero.line2')}</span>
      </h1>
    </div>
    <div class="hero__arte" aria-hidden="true">
      <img src="/images/garcete-suarez-ronco.svg" alt="" class="hero__arte-img" width="567" height="48" />
    </div>
  </section>

  <!-- ===== 2. EL ESTUDIO ===== -->
  <section id="el-estudio" class="section section--bg-oscuro" aria-labelledby="estudio-title">
    <div class="section__inner estudio__grid">
      <div class="estudio__slider scroll-animate delay-1" id="estudio-slider">
        <div class="estudio__slides">
          <div class="estudio__slide estudio__slide--active" data-slide="0">
            <p class="estudio__slide-text">{t.get('estudio.slide1')}</p>
          </div>
          <div class="estudio__slide" data-slide="1">
            <p class="estudio__slide-text">{t.get('estudio.slide2')}</p>
          </div>
          <div class="estudio__slide" data-slide="2">
            <p class="estudio__slide-text">{t.get('estudio.slide3')}</p>
          </div>
        </div>
        <div class="estudio__dots" role="tablist" aria-label={t.get('estudio.sliderAria')}>
          <button class="estudio__dot estudio__dot--active" data-target="0" role="tab" aria-selected="true" aria-label={t.get('estudio.slide1Aria')}></button>
          <button class="estudio__dot" data-target="1" role="tab" aria-selected="false" aria-label={t.get('estudio.slide2Aria')}></button>
          <button class="estudio__dot" data-target="2" role="tab" aria-selected="false" aria-label={t.get('estudio.slide3Aria')}></button>
        </div>
      </div>
      <div class="estudio__image scroll-animate delay-2">
        <img src="/images/asset-el-estudio.webp" alt={t.get('estudio.imgAlt')} class="estudio__img" loading="lazy" width="800" height="800" />
      </div>
    </div>
  </section>

  <!-- ===== 3. ÁREAS DE PRÁCTICA ===== -->
  <section id="areas" class="section section--bg-claro">
    <div class="section__inner">
      <header class="section__header section__header--center scroll-animate delay-1">
        <p class="section__label">{t.get('areas.label')}</p>
      </header>
      <div class="accordion" id="accordion-areas">
        <div class="accordion__item scroll-animate delay-1">
          <button class="accordion__header" type="button" aria-expanded="false" aria-controls="area-1">
            <span class="accordion__number">01.</span>
            <span class="accordion__title">{t.get('areas.area1Title')}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion__panel" id="area-1">
            <p class="accordion__text">{t.get('areas.area1Text')}</p>
          </div>
        </div>
        <div class="accordion__item scroll-animate delay-2">
          <button class="accordion__header" type="button" aria-expanded="false" aria-controls="area-2">
            <span class="accordion__number">02.</span>
            <span class="accordion__title">{t.get('areas.area2Title')}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion__panel" id="area-2">
            <p class="accordion__text">{t.get('areas.area2Text')}</p>
          </div>
        </div>
        <div class="accordion__item scroll-animate delay-3">
          <button class="accordion__header" type="button" aria-expanded="false" aria-controls="area-3">
            <span class="accordion__number">03.</span>
            <span class="accordion__title">{t.get('areas.area3Title')}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion__panel" id="area-3">
            <p class="accordion__text">{t.get('areas.area3Text')}</p>
          </div>
        </div>
        <div class="accordion__item scroll-animate delay-4">
          <button class="accordion__header" type="button" aria-expanded="false" aria-controls="area-4">
            <span class="accordion__number">04.</span>
            <span class="accordion__title">{t.get('areas.area4Title')}</span>
            <span class="accordion__icon" aria-hidden="true"></span>
          </button>
          <div class="accordion__panel" id="area-4">
            <p class="accordion__text">{t.get('areas.area4Text')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4. LOS SOCIOS ===== -->
